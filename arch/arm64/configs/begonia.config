# ==============================================================================
# Xiaomi Redmi Note 8 Pro (Begonia / MediaTek MT6785) Hardware Parity Config
# Verified against Begoker (Linux 4.14) vendor driver stack
# ==============================================================================

# --- Core Architecture & Interconnect ---
CONFIG_ARCH_MEDIATEK=y
CONFIG_COMMON_CLK_MT6785=y
CONFIG_PINCTRL_MT6785=y
CONFIG_MTK_PMIC_WRAP=y
CONFIG_MTK_SMI=y
CONFIG_MTK_IOMMU=y
CONFIG_MTK_CMDQ=y
CONFIG_MTK_DEVAPC=y
CONFIG_MTK_SCPSYS_PM_DOMAINS=y

# --- Storage Subsystem (UFS 2.1 & eMMC / SD Card) ---
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_MEDIATEK=y
CONFIG_PHY_MTK_UFS=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_MTK=y

# --- Display, DRM & Mali Bifrost GPU ---
CONFIG_DRM=y
CONFIG_DRM_PANFROST=y
CONFIG_MTK_MMSYS=y
CONFIG_DRM_MEDIATEK=y
# CONFIG_DRM_MEDIATEK_HDMI is not set
CONFIG_DRM_PANEL_NOVATEK_NT36672A=y
CONFIG_DRM_MIPI_DSI=y

# --- Backlight & Display Bias (TI LM36274) ---
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_MFD_TI_LMU=y
CONFIG_REGULATOR_LM363X=y
CONFIG_BACKLIGHT_LM36274=y

# --- Touchscreen & Keypad Input ---
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_NOVATEK_NVT_TS_CORE=y
CONFIG_TOUCHSCREEN_NOVATEK_NVT_TS_SPI=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_MTK_PMIC=y
CONFIG_KEYBOARD_MT6779=y

# --- Power Management, PMIC & Sub-PMIC (MT6359 & MT6360) ---
CONFIG_MFD_MT6397=y
CONFIG_REGULATOR_MT6359=y
CONFIG_MFD_MT6360=y
CONFIG_REGULATOR_MT6360=y
CONFIG_CHARGER_MT6360=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_FLASH=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_LEDS_MT6360=y
CONFIG_MEDIATEK_MT6360_ADC=y
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_TCPCI=y
CONFIG_TYPEC_MT6360=y
CONFIG_POWER_SUPPLY=y

# --- USB 3.0 / 2.0 & Type-C ---
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_MTU3=y
CONFIG_USB_MTU3_DUAL_ROLE=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_MTK=y
CONFIG_PHY_MTK_TPHY=y
CONFIG_USB_ROLE_SWITCH=y

# --- Sensors, Haptics & IIO ---
CONFIG_IIO=y
CONFIG_IIO_BUFFER=y
CONFIG_IIO_KFIFO_BUF=y
CONFIG_IIO_TRIGGER=y
CONFIG_BMI160=y
CONFIG_BMI160_SPI=y
CONFIG_AK8975=y
CONFIG_STK3310=y
CONFIG_INPUT_REGULATOR_HAPTIC=y
CONFIG_I2C_GPIO=y

# --- NFC, RF & Wireless ---
CONFIG_RFKILL=y
CONFIG_NFC=y
CONFIG_NFC_NCI=y
CONFIG_NFC_NXP_NCI=y
CONFIG_NFC_NXP_NCI_I2C=y
CONFIG_BT=y
CONFIG_BT_MTK=y
CONFIG_BT_MTKUART=y
CONFIG_BT_MTKSDIO=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y

# --- Audio Subsystem (MT6359 Codec & Accdet) ---
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_MT6359=y
CONFIG_SND_SOC_MT6359_ACCDET=y

# --- Thermal, RTC & Watchdog ---
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_CPU_THERMAL=y
CONFIG_MTK_THERMAL=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_MT6397=y
CONFIG_WATCHDOG=y
CONFIG_MEDIATEK_WATCHDOG=y

# --- Android IPC, Resource Tracking & LMKD (Android 10 - 16) ---
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_PSI=y
CONFIG_MEMCG=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_NAMESPACES=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES=y

# --- Filesystems (Data, System & Super partitions) ---
CONFIG_F2FS_FS=y
CONFIG_F2FS_STAT_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_OVERLAY_FS=y
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_SWAP=y

# --- Debug & Information ---
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# CONFIG_LOCALVERSION_AUTO is not set
# CONFIG_MODULE_SIG_ALL is not set
# CONFIG_MODULE_SIG_FORCE is not set
